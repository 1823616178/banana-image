{
  "name": "banana-image",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "worker": "tsx --tsconfig .nuxt/tsconfig.server.json server/worker.ts",
    "dev:worker": "tsx watch --tsconfig .nuxt/tsconfig.server.json server/worker.ts",
    "storage:migrate-ftp": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/migrate-storage-ftp.ts",
    "probe:models": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/probe-models.ts",
    "check:classnames": "node scripts/check-classnames.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:classnames && npm run test"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "basic-ftp": "^6.2.3",
    "chart.js": "^4.6.1",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "nuxt": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}

DB_HOST=192.168.1.111
DB_PORT=53306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=banana_image
DB_SYNCHRONIZE=true
DB_LOGGING=false
REDIS_HOST=192.168.1.111
REDIS_PORT=56379
REDIS_PASSWORD=your_redis_password
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
DEFAULT_IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-2.5-flash-image
# 商汤日日新（SenseNova，可选；国内网络直连）
# 申请地址：https://platform.sensenova.cn
# U1.5 Lite 支持文生图和图生图；图生图最多 5 张参考图，第一张为主编辑图
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_DEFAULT_MODEL=sensenova-u1.5-lite
SENSENOVA_MODELS=sensenova-u1.5-lite
# 参考图提示词推荐：多模态文本模型与每人每分钟次数上限
PROMPT_RECOMMEND_MODEL=gemini-3.1-flash-lite
PROMPT_RECOMMEND_PER_MINUTE=6
# FTP 主存储（可选）：配置 FTP_HOST 后，上传图与生成图（原图+缩略图）先写入 FTP_DIR，成功后才入库；
# 页面与下载经服务端 /api/files 代理读取，本地 storage/.ftp-cache 仅作缓存。FTP_HOST 留空则仍存本地 storage。
FTP_ENABLED=true
FTP_HOST=
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_DIR=/banana
FTP_SECURE=false
FTP_POOL_SIZE=3
FTP_TIMEOUT_MS=15000
FTP_CACHE_MAX_MB=512
STORAGE_DIR=./storage
WORKER_CONCURRENCY=2
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ACCESS_PASSWORD=
# 登录：首个账号可直接注册；之后只有设为 true 才开放注册
ALLOW_REGISTRATION=false
# 通过 HTTPS 访问时设为 true，会话 Cookie 仅经 HTTPS 发送
COOKIE_SECURE=false
